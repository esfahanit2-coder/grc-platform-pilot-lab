APP_ENV=production
GRC_RELEASE_VERSION=local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
# Keep the audit-integrity key separate from DJANGO_SECRET_KEY. Use at least
# 32 random bytes and preserve it with protected recovery material.
AUDIT_INTEGRITY_KEY=replace-with-at-least-32-random-bytes
AUDIT_INTEGRITY_KEY_ID=v1
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=grc.example.internal
CORS_ALLOWED_ORIGINS=https://grc.example.internal
CSRF_TRUSTED_ORIGINS=https://grc.example.internal

POSTGRES_DB=grc
POSTGRES_USER=grc
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Shared production cache for login/MFA/refresh throttles. Keep it reachable only
# by trusted application services; a dedicated Redis DB/instance may be used.
AUTH_THROTTLE_REDIS_URL=redis://redis:6379/0
AUTH_LOGIN_RATE=10/min
AUTH_MFA_RATE=12/min
AUTH_REFRESH_RATE=30/min

# Operational health thresholds. The beat→worker heartbeat proves the async
# pipeline end-to-end; backup freshness becomes critical in production.
OPS_ASYNC_HEARTBEAT_MAX_AGE_SECONDS=180
OPS_BACKUP_MAX_AGE_HOURS=26
OPS_CELERY_QUEUE_WARN_DEPTH=1000
# Prometheus scrape credential. In production this endpoint fails closed when unset.
# Send it as: Authorization: Bearer <OPS_METRICS_TOKEN>
OPS_METRICS_TOKEN=replace-with-long-random-metrics-token
GRC_LOG_LEVEL=INFO

# Bundled pilot S3-compatible object storage (SeaweedFS in docker-compose.pilot.yml).
# For an approved external S3-compatible service, replace the endpoint/credentials;
# application code remains storage-provider agnostic.
S3_ENDPOINT_URL=http://objectstore:8333
S3_REGION=us-east-1
S3_BUCKET=grc-evidence
S3_ACCESS_KEY=replace-with-strong-objectstore-access-key
S3_SECRET_KEY=replace-with-strong-objectstore-secret-key
S3_USE_SSL=0

# Evidence files are quarantined until a server-owned malware scan marks the
# exact stored bytes clean. Keep scanner disabled until an approved endpoint is
# available; production downloads remain fail-closed while disabled/pending.
EVIDENCE_MAX_FILE_SIZE=26214400
EVIDENCE_REQUIRE_CLEAN_DOWNLOAD=1
EVIDENCE_MALWARE_SCANNER=disabled
EVIDENCE_MALWARE_SCAN_AUTOSUBMIT=1
EVIDENCE_MALWARE_SCAN_MAX_RETRIES=3
EVIDENCE_MALWARE_SCAN_RETRY_SECONDS=30
# To enable the built-in clamd INSTREAM client, set EVIDENCE_MALWARE_SCANNER=clamd
# and point CLAMD_HOST at an approved internal scanner endpoint. clamd TCP is not
# authenticated or encrypted; never expose it to an untrusted network.
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15
CLAMD_CHUNK_SIZE=1048576

MFA_ENCRYPTION_KEY=replace-with-valid-fernet-key
MFA_ISSUER=GRC Platform

AUTH_COOKIE_MODE=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=0
AUTH_COOKIE_SAMESITE=Strict

# AI can be disabled globally without changing domain code.
AI_ENABLED=1
AI_RAG_MODE=hybrid
AI_DEFAULT_CLASSIFICATION=internal
# The optional compose profile `local-ai` exposes Ollama internally at:
# http://ollama:11434
# Create a tenant AIProviderConfig of type `ollama` and point it there.
# Model files must be preloaded/imported for an air-gapped deployment; the stack
# deliberately does not download models on startup.

CONNECTOR_HTTP_TIMEOUT=30
CONNECTOR_MAX_RESPONSE_BYTES=5242880

# Connector secrets referenced by ConnectorConfig.secret_env_var / username_env_var.
FORTIGATE_API_TOKEN=
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
VEEAM_USERNAME=
VEEAM_PASSWORD=
AD_BIND_USERNAME=
AD_BIND_PASSWORD=

# TLS override (`docker-compose.pilot.tls.yml`). Keep private keys outside Git.
TLS_CERT_PATH=./runtime/tls/server.crt
TLS_KEY_PATH=./runtime/tls/server.key

# SMTP notification delivery. Keep credentials only in the deployment secret store/.env.
NOTIFICATION_EMAIL_ENABLED=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=grc@example.internal
EMAIL_SUBJECT_PREFIX=[GRC]
APP_BASE_URL=https://grc.example.internal
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_EMAIL_RETRY_SECONDS=300
NOTIFICATION_DUE_SOON_DAYS=3
