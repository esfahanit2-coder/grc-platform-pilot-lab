# --- Core ---
APP_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- PostgreSQL ---
POSTGRES_DB=grc
POSTGRES_USER=grc
POSTGRES_PASSWORD=grc-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
AUTH_THROTTLE_REDIS_URL=redis://redis:6379/0
AUTH_LOGIN_RATE=10/min
AUTH_MFA_RATE=12/min
AUTH_REFRESH_RATE=30/min

# --- S3-compatible object storage ---
S3_ENDPOINT_URL=http://object-storage:9000
S3_REGION=us-east-1
S3_BUCKET=grc-evidence
S3_ACCESS_KEY=grc-dev
S3_SECRET_KEY=grc-dev-secret
S3_USE_SSL=0

# Evidence
EVIDENCE_MAX_FILE_SIZE=26214400
# Development defaults to off; production defaults to on. Uploaded blobs are
# still marked pending until a real scanner/integration clears them.
EVIDENCE_REQUIRE_CLEAN_DOWNLOAD=0

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=/api/v1

# MFA
MFA_ENCRYPTION_KEY=
MFA_ISSUER=GRC Platform

# --- Sprint 6 AI Gateway ---
# AI provider records reference secret variable names; keys themselves are not stored in DB.
OPENAI_API_KEY=
PRIVATE_AI_API_KEY=
AI_ENABLED=1
AI_DEFAULT_CLASSIFICATION=internal
AI_MAX_CONTEXT_CHARS=24000
# Example local endpoint used by an Ollama provider record: http://ollama:11434

# --- Production security ---
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_PRELOAD=0
CSRF_TRUSTED_ORIGINS=
AUTH_COOKIE_MODE=0
AUTH_ACCESS_COOKIE=grc_access
AUTH_REFRESH_COOKIE=grc_refresh
AUTH_COOKIE_SAMESITE=Strict

# Pilot hardening / semantic RAG
AI_RAG_MODE=hybrid
AI_EMBED_BATCH_SIZE=32
CONNECTOR_HTTP_TIMEOUT=30
CONNECTOR_MAX_RESPONSE_BYTES=5242880

# Connector secrets are referenced by name in the DB; never paste them into connector configuration JSON.
FORTIGATE_API_TOKEN=
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
VEEAM_USERNAME=
VEEAM_PASSWORD=
AD_BIND_USERNAME=
AD_BIND_PASSWORD=
